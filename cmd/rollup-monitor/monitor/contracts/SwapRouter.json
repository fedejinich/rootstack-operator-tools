;8660:72;:::i;:::-;8742;8810:2;8799:9;8795:18;8786:6;8742:72;:::i;:::-;8268:553;;;;;;;:::o","linkReferences":{}},"methodIdentifiers":{"swap(address,address,uint256,uint256,address,uint256)":"9908fc8b"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.25+commit.b61c2a91\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"sender\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"tokenIn\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"tokenOut\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amountIn\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amountOut\",\"type\":\"uint256\"}],\"name\":\"Swap\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"tokenIn\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"tokenOut\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amountIn\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"amountOutMin\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"}],\"name\":\"swap\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"amountOut\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"Minimal mock swap router used by the swap-overhead experiment. Performs a fixed 1:1 swap: pulls `amountIn` of `tokenIn` from the caller via transferFrom, sends the same amount of `tokenOut` to `to` from the router's reserves, emits a Swap event. Calldata shape (4 + 6*32 = 196 bytes) matches mainstream router APIs so L1-batch-cost analysis is representative; gas profile (~60k\\u201370k) is realistic for a no-AMM-math router with two ERC-20 hops and a log. The router must hold a `tokenOut` reserve large enough to cover the run \\u2014 the experiment driver seeds reserves at deploy time.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contract/MockSwapRouter.sol\":\"MockSwapRouter\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[]},\"sources\":{\"contract/MockSwapRouter.sol\":{\"keccak256\":\"0xcd386623be44b59b8eb8bc67a6efe08169b7dc9b43cf8cfd47868d378e6fbe80\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6fd871fdd11304bfbb0fc443c0b97ec9e8bdee9f50ab6c363c83b47d0637f1d9\",\"dweb:/ipfs/QmSVp9tjXVfah8g17vcN2QCjGGCH6QTRjdvGi84nKnSFny\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.25+commit.b61c2a91"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"sender","type":"address","indexed":true},{"internalType":"address","name":"to","type":"address","indexed":true},{"internalType":"address","name":"tokenIn","type":"address","indexed":false},{"internalType":"address","name":"tokenOut","type":"address","indexed":false},{"internalType":"uint256","name":"amountIn","type":"uint256","indexed":false},{"internalType":"uint256","name":"amountOut","type":"uint256","indexed":false}],"type":"event","name":"Swap","anonymous":false},{"inputs":[{"internalType":"address","name":"tokenIn","type":"address"},{"internalType":"address","name":"tokenOut","type":"address"},{"internalType":"uint256","name":"amountIn","type":"uint256"},{"internalType":"uint256","name":"amountOutMin","type":"uint256"},{"internalType":"address","name":"to","type":"address"},{"internalType":"uint256","name":"deadline","type":"uint256"}],"stateMutability":"nonpayable","type":"function","name":"swap","outputs":[{"internalType":"uint256","name":"amountOut","type":"uint256"}]}],"devdoc":{"kind":"dev","methods":{},"version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"remappings":[],"optimizer":{"enabled":false,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"contract/MockSwapRouter.sol":"MockSwapRouter"},"evmVersion":"paris","libraries":{}},"sources":{"contract/MockSwapRouter.sol":{"keccak256":"0xcd386623be44b59b8eb8bc67a6efe08169b7dc9b43cf8cfd47868d378e6fbe80","urls":["bzz-raw://6fd871fdd11304bfbb0fc443c0b97ec9e8bdee9f50ab6c363c83b47d0637f1d9","dweb:/ipfs/QmSVp9tjXVfah8g17vcN2QCjGGCH6QTRjdvGi84nKnSFny"],"license":"MIT"}},"version":1},"id":0}